  if(SUCCEEDED(hr)&&dxd){IDXGIAdapter*adp=NULL;IDXGIDevice_GetAdapter(dxd,&adp);
    if(adp){IDXGIFactory*fac=NULL;IDXGIAdapter_GetParent(adp,&IID_IDXGIFactory,(void**)&fac);
      if(fac){void**v=vt(fac);
