def main():
    parser = argparse.ArgumentParser(
        description="CrosshairX — 精确像素绿色十字准星",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
操作 (默认模式):
  方向键          移动准星 1 像素
  Shift+方向键    移动准星 10 像素
  R               重置偏移
  M               循环切换显示器
  1-9             直接跳转到指定显示器
  退出            关闭控制面板窗口

子命令:
  inject <进程>   DLL 注入模式
  build-dll       编译 DLL

无子命令时默认启动 GUI 控制面板。
用 --no-gui 可跳过 GUI 仅用热键。
        """
    )
    parser.add_argument('-m', '--monitor', type=int, default=1)
    parser.add_argument('-x', '--offset-x', type=int, default=0)
    parser.add_argument('-y', '--offset-y', type=int, default=0)
    parser.add_argument('-c', '--color', type=str, default='0,255,0,230')
    parser.add_argument('-r', '--radius', type=int, default=6)
    parser.add_argument('-w', '--width',  type=int, default=2)
    parser.add_argument('--no-gui', action='store_true', help='不使用控制面板 (纯热键模式)')

    sub = parser.add_subparsers(dest='cmd')

    p_inj = sub.add_parser('inject', help='DLL 注入')
    p_inj.add_argument('target');p_inj.add_argument('-x','--offset-x',type=int,default=0)
    p_inj.add_argument('-y','--offset-y',type=int,default=0)
    p_inj.add_argument('-c','--color',type=str,default='0,255,0,230')
    p_inj.add_argument('-r','--radius',type=int,default=6)
    p_inj.add_argument('-w','--width',type=int,default=2)
    p_inj.add_argument('--dll');p_inj.add_argument('--list',action='store_true')
    p_inj.add_argument('--no-confirm',action='store_true')

    p_b = sub.add_parser('build-dll', help='编译 DLL')
    p_b.add_argument('--msvc',action='store_true')

    args = parser.parse_args()

    if args.cmd == 'inject':
        inject(args.target, offset_x=args.offset_x, offset_y=args.offset_y,
               radius=args.radius, width=args.width, color=args.color,
               dll=args.dll, list_only=args.list, no_confirm=args.no_confirm)
    elif args.cmd == 'build-dll':
        build_dll(args.msvc)
    else:
        if args.no_gui:
            run_overlay_cli(args)
        else:
            run_overlay_gui(args)


if __name__ == '__main__':
    main()
