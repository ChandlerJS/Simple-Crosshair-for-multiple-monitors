#!/usr/bin/env python3
r"""
CrosshairX —— 精确绿色十字准星覆盖层
========================================
- 小窗口 + 每像素 Alpha → 宽度以真实物理像素计量
- tkinter 控制面板：开关热键、调粗细/颜色/不透明度
- M / 1-9 切换显示器

用法:
    python CrosshairX                    覆盖模式 + 控制面板
    python CrosshairX -m 2 -x 5 -y -3    命令行参数启动
    python CrosshairX inject <进程名>     注入模式 (独占全屏)
    python CrosshairX build-dll          编译 DLL
"""

import ctypes
from ctypes import wintypes, POINTER, Structure, c_void_p, byref, sizeof, cast, WINFUNCTYPE
import sys
import os
import argparse

# ── DPI ──────────────────────────────────────────────────────────
try:
    ctypes.windll.shcore.SetProcessDpiAwareness(2)
except Exception:
    try:
        ctypes.windll.user32.SetProcessDPIAware()
    except Exception:
        pass

# ── Win32 API ────────────────────────────────────────────────────
user32   = ctypes.windll.user32
gdi32    = ctypes.windll.gdi32
kernel32 = ctypes.windll.kernel32

# ── 常量 ─────────────────────────────────────────────────────────
WS_EX_LAYERED    = 0x00080000
WS_EX_TRANSPARENT = 0x00000020
WS_EX_TOPMOST    = 0x00000008
WS_EX_NOACTIVATE = 0x08000000
WS_EX_TOOLWINDOW = 0x00000080
WS_POPUP         = 0x80000000

ULW_ALPHA      = 0x00000002
AC_SRC_OVER    = 0x00
AC_SRC_ALPHA   = 0x01

SWP_NOACTIVATE = 0x0010
SWP_SHOWWINDOW = 0x0040
SWP_NOMOVE     = 0x0002
SWP_NOSIZE     = 0x0001
HWND_TOPMOST   = -1
SW_SHOWNOACTIVATE = 4

WM_DESTROY       = 0x0002
WM_TIMER         = 0x0113
WM_DISPLAYCHANGE = 0x007E
WH_KEYBOARD_LL   = 13
WM_KEYDOWN       = 0x0100
WM_SYSKEYDOWN    = 0x0104

VK_LEFT = 0x25; VK_UP = 0x26; VK_RIGHT = 0x27; VK_DOWN = 0x28
VK_R = 0x52; VK_M = 0x4D; VK_SHIFT = 0x10
VK_0 = 0x30; VK_1 = 0x31; VK_2 = 0x32; VK_3 = 0x33; VK_4 = 0x34
VK_5 = 0x35; VK_6 = 0x36; VK_7 = 0x37; VK_8 = 0x38; VK_9 = 0x39
VK_CTRL  = 0x11
VK_MENU  = 0x12  # Alt

DIB_RGB_COLORS = 0; NULL_BRUSH = 5

# ── 结构体 ───────────────────────────────────────────────────────
class POINT(Structure):
    _fields_ = [('x', ctypes.c_long), ('y', ctypes.c_long)]
class SIZE(Structure):
    _fields_ = [('cx', ctypes.c_long), ('cy', ctypes.c_long)]
class MSG(Structure):
    _fields_ = [('hwnd', wintypes.HWND), ('message', wintypes.UINT),
                ('wParam', wintypes.WPARAM), ('lParam', wintypes.LPARAM),
                ('time', wintypes.DWORD), ('pt', POINT)]
class RECT(Structure):
    _fields_ = [('left', ctypes.c_long), ('top', ctypes.c_long),
                ('right', ctypes.c_long), ('bottom', ctypes.c_long)]
class MONITORINFOEX(Structure):
    _fields_ = [('cbSize', wintypes.DWORD), ('rcMonitor', RECT),
                ('rcWork', RECT), ('dwFlags', wintypes.DWORD),
                ('szDevice', ctypes.c_wchar * 32)]
class WNDCLASSEX(Structure):
    _fields_ = [('cbSize', wintypes.UINT), ('style', wintypes.UINT),
                ('lpfnWndProc', c_void_p), ('cbClsExtra', ctypes.c_int),
                ('cbWndExtra', ctypes.c_int), ('hInstance', wintypes.HINSTANCE),
                ('hIcon', wintypes.HANDLE), ('hCursor', wintypes.HANDLE),
                ('hbrBackground', wintypes.HBRUSH), ('lpszMenuName', ctypes.c_wchar_p),
                ('lpszClassName', ctypes.c_wchar_p), ('hIconSm', wintypes.HANDLE)]
class BITMAPINFOHEADER(Structure):
    _fields_ = [('biSize', wintypes.DWORD), ('biWidth', wintypes.LONG),
                ('biHeight', wintypes.LONG), ('biPlanes', wintypes.WORD),
                ('biBitCount', wintypes.WORD), ('biCompression', wintypes.DWORD),
                ('biSizeImage', wintypes.DWORD), ('biXPelsPerMeter', wintypes.LONG),
                ('biYPelsPerMeter', wintypes.LONG), ('biClrUsed', wintypes.DWORD),
                ('biClrImportant', wintypes.DWORD)]
class BITMAPINFO(Structure):
    _fields_ = [('bmiHeader', BITMAPINFOHEADER)]
class BLENDFUNCTION(Structure):
    _fields_ = [('BlendOp', wintypes.BYTE), ('BlendFlags', wintypes.BYTE),
                ('SourceConstantAlpha', wintypes.BYTE), ('AlphaFormat', wintypes.BYTE)]
class KBDLLHOOKSTRUCT(Structure):
    _fields_ = [('vkCode', wintypes.DWORD), ('scanCode', wintypes.DWORD),
                ('flags', wintypes.DWORD), ('time', wintypes.DWORD),
                ('dwExtraInfo', POINTER(ctypes.c_ulong))]

# ── argtypes ─────────────────────────────────────────────────────
user32.DefWindowProcW.argtypes   = [wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM]
user32.DefWindowProcW.restype    = ctypes.c_longlong
user32.SetWindowPos.argtypes     = [wintypes.HWND, wintypes.HWND, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, wintypes.UINT]
user32.ShowWindow.argtypes       = [wintypes.HWND, ctypes.c_int]
user32.DestroyWindow.argtypes    = [wintypes.HWND]
user32.PostQuitMessage.argtypes  = [ctypes.c_int]
user32.SetTimer.argtypes         = [wintypes.HWND, ctypes.c_ulonglong, wintypes.UINT, c_void_p]
user32.RegisterClassExW.argtypes = [POINTER(WNDCLASSEX)]
user32.CreateWindowExW.argtypes  = [wintypes.DWORD, wintypes.LPCWSTR, wintypes.LPCWSTR, wintypes.DWORD, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, wintypes.HWND, wintypes.HMENU, wintypes.HINSTANCE, wintypes.LPVOID]
user32.EnumDisplayMonitors.argtypes = [wintypes.HDC, POINTER(RECT), c_void_p, wintypes.LPARAM]
user32.GetMonitorInfoW.argtypes  = [wintypes.HMONITOR, POINTER(MONITORINFOEX)]
user32.GetMessageW.argtypes      = [POINTER(MSG), wintypes.HWND, wintypes.UINT, wintypes.UINT]
user32.TranslateMessage.argtypes = [POINTER(MSG)]
user32.DispatchMessageW.argtypes = [POINTER(MSG)]
user32.UpdateLayeredWindow.argtypes = [wintypes.HWND, wintypes.HDC, POINTER(POINT), POINTER(SIZE), wintypes.HDC, POINTER(POINT), wintypes.COLORREF, POINTER(BLENDFUNCTION), wintypes.DWORD]
user32.GetDC.argtypes            = [wintypes.HWND]
user32.ReleaseDC.argtypes        = [wintypes.HWND, wintypes.HDC]
user32.SetWindowsHookExW.argtypes = [ctypes.c_int, c_void_p, wintypes.HINSTANCE, wintypes.DWORD]
user32.UnhookWindowsHookEx.argtypes = [wintypes.HHOOK]
user32.CallNextHookEx.argtypes   = [wintypes.HHOOK, ctypes.c_int, wintypes.WPARAM, wintypes.LPARAM]
user32.CallNextHookEx.restype    = ctypes.c_longlong
user32.GetAsyncKeyState.argtypes = [ctypes.c_int]
user32.PostMessageW.argtypes     = [wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM]
user32.GetPhysicalCursorPos.argtypes = [POINTER(POINT)]
# unused: SetPhysicalCursorPos, MoveWindow

gdi32.CreateCompatibleDC.argtypes = [wintypes.HDC]
gdi32.DeleteDC.argtypes          = [wintypes.HDC]
gdi32.CreateDIBSection.argtypes  = [wintypes.HDC, POINTER(BITMAPINFO), wintypes.UINT, POINTER(c_void_p), wintypes.HANDLE, wintypes.DWORD]
gdi32.SelectObject.argtypes      = [wintypes.HDC, wintypes.HGDIOBJ]
gdi32.DeleteObject.argtypes      = [wintypes.HGDIOBJ]
gdi32.GetStockObject.argtypes    = [ctypes.c_int]

kernel32.GetModuleHandleW.argtypes = [wintypes.LPCWSTR]

_hinstance = kernel32.GetModuleHandleW(None)


# ══════════════════════════════════════════════════════════════════
#  CrosshairOverlay —— 精确像素十字准星
# ══════════════════════════════════════════════════════════════════

class CrosshairOverlay:
    """
    小窗口精确像素准星覆盖层。

    关键: 窗口只覆盖准星周围的小区域 (如 40×40px)，DIB 中的每个
    像素直接对应屏幕物理像素，不受显示器 DPI 缩放影响。
    """

    def __init__(self):
        # ── 准星参数 ──
        self.radius  = 6    # 十字单臂长度 (px)
        self.thickness = 2  # 线宽 (px) — 精确物理像素
        self.r = 0; self.g = 255; self.b = 0; self.a = 230

        # ── 位置 ──
        self.offset_x = 0
        self.offset_y = 0
        self.monitor_idx = 0
        self.monitors = []

        # ── 内部状态 ──
        self.hwnd       = None
        self.hook_id    = None
        self.running    = False
        self.hotkeys_enabled = True  # 控制面板可禁用

        # ── 渲染 ──
        self._mem_dc   = None
        self._dib_bmp  = None
        self._old_bmp  = None
        self._pBits    = None
        self._dib_size = 0   # 当前 DIB 边长
        self._last_pos = (-9999, -9999)  # 上次渲染位置

    # ── 显示器 ──────────────────────────────────────────────────
    def enum_monitors(self):
        self.monitors = []

        @WINFUNCTYPE(wintypes.BOOL, wintypes.HMONITOR, wintypes.HDC, POINTER(RECT), wintypes.LPARAM)
        def cb(hMon, hdc, rc, dw):
            mi = MONITORINFOEX()
            mi.cbSize = sizeof(MONITORINFOEX)
            if user32.GetMonitorInfoW(hMon, byref(mi)):
                self.monitors.append({
                    'rect': mi.rcMonitor, 'work': mi.rcWork,
                    'primary': bool(mi.dwFlags & 1), 'device': mi.szDevice,
                })
            return True

        user32.EnumDisplayMonitors(None, None, cb, 0)
        self.monitors.sort(key=lambda m: not m['primary'])

    def monitor_rect(self):
        idx = max(0, min(self.monitor_idx, len(self.monitors) - 1))
        return self.monitors[idx]['rect']

    def monitor_center(self):
        r = self.monitor_rect()
        return (r.left + r.right) // 2, (r.top + r.bottom) // 2

    def num_monitors(self):
        return len(self.monitors)

    # ── 计算需要的最小窗口尺寸 ─────────────────────────────────
    def _required_size(self):
        """返回能容纳准星的最小窗口边长（偶数，对齐像素）"""
        # 准星总宽度/高度 = radius*2 + thickness，加少量 padding
        needed = max(self.radius * 2 + self.thickness, self.thickness * 2 + self.radius * 2)
        needed += 4  # 每边 2px padding
        # 对齐到 2 的倍数（确保中心对齐）
        return max(8, (needed + 1) // 2 * 2)

    # ── 颜色 ─────────────────────────────────────────────────────
    @property
    def _bgra(self):
        return ((self.a << 24) | (self.r << 16) | (self.g << 8) | self.b)

    # ── 渲染引擎 ────────────────────────────────────────────────
    def _ensure_dib(self, new_size):
        """确保 DIB 缓冲区存在且尺寸正确。"""
        if new_size == self._dib_size and self._pBits:
            return

        if self._dib_bmp:
            if self._old_bmp:
                gdi32.SelectObject(self._mem_dc, self._old_bmp)
                self._old_bmp = None
            gdi32.DeleteObject(self._dib_bmp)
            self._dib_bmp = None

        if not self._mem_dc:
            dc = user32.GetDC(None)
            self._mem_dc = gdi32.CreateCompatibleDC(dc)
            user32.ReleaseDC(None, dc)

        w = h = new_size
        bmi = BITMAPINFO()
        bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER)
        bmi.bmiHeader.biWidth  = w
        bmi.bmiHeader.biHeight = -h
        bmi.bmiHeader.biPlanes = 1
        bmi.bmiHeader.biBitCount = 32
        bmi.bmiHeader.biCompression = 0

        pv = c_void_p()
        self._dib_bmp = gdi32.CreateDIBSection(self._mem_dc, byref(bmi),
                                                DIB_RGB_COLORS, byref(pv), None, 0)
        self._old_bmp = gdi32.SelectObject(self._mem_dc, self._dib_bmp)
        self._pBits = pv
        self._dib_size = new_size
        self._last_pos = (-9999, -9999)

    def _paint(self):
        """在 DIB 缓冲区中直接写像素绘制准星。每个像素都是精确的。"""
        size = self._dib_size
        pixels = ctypes.cast(self._pBits, POINTER(ctypes.c_uint32))
        total = size * size

        # 全透明
        ctypes.memset(self._pBits, 0, total * 4)

        color = self._bgra
        cx = size // 2  # 窗口中心 X
        cy = size // 2  # 窗口中心 Y

        # ── 水平线 ──
        # 厚度从 cy 向上 spread
        top    = cy - self.thickness // 2
        bottom = top + self.thickness
        left   = cx - self.radius
        right  = cx + self.radius
        for row in range(max(0, top), min(size, bottom)):
            base = row * size
            for col in range(max(0, left), min(size, right + 1)):
                pixels[base + col] = color

        # ── 垂直线 ──
        top    = cy - self.radius
        bottom = cy + self.radius
        left   = cx - self.thickness // 2
        right  = left + self.thickness
        for row in range(max(0, top), min(size, bottom + 1)):
            base = row * size
            for col in range(max(0, left), min(size, right)):
                pixels[base + col] = color

    def update_overlay(self):
        """渲染并更新窗口。（小窗口方案）"""
        center_x, center_y = self.monitor_center()
        target_x = center_x + self.offset_x
        target_y = center_y + self.offset_y

        # 确定需要的 DIB 尺寸
        sz = self._required_size()
        self._ensure_dib(sz)

        # 位置变了才重绘
        if (target_x, target_y) == self._last_pos and self._dib_size == sz:
            return

        self._paint()

        # 窗口左上角
        win_x = target_x - sz // 2
        win_y = target_y - sz // 2

        # UpdateLayeredWindow：小窗口，每个 DIB 像素 = 1 屏幕物理像素
        ptDest = POINT(win_x, win_y)
        szWnd  = SIZE(sz, sz)
        ptSrc  = POINT(0, 0)
        blend  = BLENDFUNCTION(AC_SRC_OVER, 0, 255, AC_SRC_ALPHA)

        screen_dc = user32.GetDC(None)
        user32.UpdateLayeredWindow(self.hwnd, screen_dc, byref(ptDest), byref(szWnd),
                                    self._mem_dc, byref(ptSrc), 0, byref(blend), ULW_ALPHA)
        user32.ReleaseDC(None, screen_dc)

        # 置顶
        user32.SetWindowPos(self.hwnd, HWND_TOPMOST, 0, 0, 0, 0,
                            SWP_NOACTIVATE | SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW)

        self._last_pos = (target_x, target_y)

    def destroy_render(self):
        if self._mem_dc:
            if self._old_bmp:
                gdi32.SelectObject(self._mem_dc, self._old_bmp)
                self._old_bmp = None
            if self._dib_bmp:
                gdi32.DeleteObject(self._dib_bmp)
                self._dib_bmp = None
            gdi32.DeleteDC(self._mem_dc)
            self._mem_dc = None
        self._pBits = None

    # ── 窗口 ────────────────────────────────────────────────────
    _cls_cb = None

    def create_window(self):
        """创建小覆盖窗口。"""
        cls = "CrosshairX_SmallOverlay"
        sz = self._required_size()

        # 窗口过程
        def wnd_proc(hwnd, msg, wParam, lParam):
            if msg == WM_TIMER:
                self.update_overlay()
                return 0
            elif msg == WM_DISPLAYCHANGE:
                self.enum_monitors()
                return 0
            elif msg == WM_DESTROY:
                self.running = False
                user32.KillTimer(hwnd, 100)
                user32.PostQuitMessage(0)
                return 0
            return user32.DefWindowProcW(hwnd, msg, wParam, lParam)

        CrosshairOverlay._cls_cb = WINFUNCTYPE(ctypes.c_longlong, wintypes.HWND, wintypes.UINT,
                                                ctypes.c_ulonglong, ctypes.c_ulonglong)(wnd_proc)

        wc = WNDCLASSEX()
        wc.cbSize = sizeof(WNDCLASSEX)
        wc.lpfnWndProc   = cast(CrosshairOverlay._cls_cb, c_void_p)
        wc.hInstance     = _hinstance
        wc.hbrBackground = gdi32.GetStockObject(NULL_BRUSH)
        wc.lpszClassName = cls

        if not user32.RegisterClassExW(byref(wc)):
            raise RuntimeError(f"RegisterClassEx 失败: {kernel32.GetLastError()}")

        cx, cy = self.monitor_center()
        x = cx - sz // 2
        y = cy - sz // 2

        ex_style = WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_TOPMOST | WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW
        self.hwnd = user32.CreateWindowExW(ex_style, cls, "CrosshairX", WS_POPUP,
                                            x, y, sz, sz, None, None, _hinstance, None)
        if not self.hwnd:
            raise RuntimeError(f"CreateWindowEx 失败: {kernel32.GetLastError()}")

        user32.ShowWindow(self.hwnd, SW_SHOWNOACTIVATE)
        self.update_overlay()
        user32.SetTimer(self.hwnd, 100, 16, None)  # ~60fps
        self.running = True

    # ── 键盘 Hook ───────────────────────────────────────────────
    _instance = None

    def _on_key(self, vk):
        if not self.hotkeys_enabled:
            return
        shift = (user32.GetAsyncKeyState(VK_SHIFT) & 0x8000) != 0
        step  = 10 if shift else 1
        changed = False

        if   vk == VK_LEFT:   self.offset_x -= step; changed = True
        elif vk == VK_RIGHT:  self.offset_x += step; changed = True
        elif vk == VK_UP:     self.offset_y -= step; changed = True
        elif vk == VK_DOWN:   self.offset_y += step; changed = True
        elif vk == VK_R:
            self.offset_x = 0; self.offset_y = 0; changed = True
        elif vk == VK_M and len(self.monitors) > 1:
            self.monitor_idx = (self.monitor_idx + 1) % len(self.monitors)
            self.offset_x = 0; self.offset_y = 0
            r = self.monitor_rect()
            w, h = r.right - r.left, r.bottom - r.top
            print(f"  → 显示器 [{self.monitor_idx + 1}] {w}x{h}")
        elif vk in (VK_1, VK_2, VK_3, VK_4, VK_5, VK_6, VK_7, VK_8, VK_9):
            idx = vk - VK_1
            if idx < len(self.monitors) and idx != self.monitor_idx:
                self.monitor_idx = idx
                self.offset_x = 0; self.offset_y = 0
                r = self.monitor_rect()
                w, h = r.right - r.left, r.bottom - r.top
                print(f"  → 显示器 [{self.monitor_idx + 1}] {w}x{h}")

        if changed:
            self._last_pos = (-9999, -9999)  # 强制重绘
            print(f"  偏移: ({self.offset_x:+d}, {self.offset_y:+d})")

    def install_hook(self):
        CrosshairOverlay._instance = self
        HK = WINFUNCTYPE(ctypes.c_longlong, ctypes.c_int, ctypes.c_ulonglong, ctypes.c_ulonglong)

        def _hk(nCode, wParam, lParam):
            if nCode >= 0 and (wParam == WM_KEYDOWN or wParam == WM_SYSKEYDOWN):
                kb = cast(lParam, POINTER(KBDLLHOOKSTRUCT)).contents
                inst = CrosshairOverlay._instance
                if inst:
                    inst._on_key(kb.vkCode)
            return user32.CallNextHookEx(None, nCode, wParam, lParam)

        self._hk_cb = HK(_hk)
        self.hook_id = user32.SetWindowsHookExW(WH_KEYBOARD_LL, self._hk_cb, None, 0)
        if not self.hook_id:
            raise RuntimeError(f"SetWindowsHookEx 失败: {kernel32.GetLastError()}")

    def uninstall_hook(self):
        if self.hook_id:
            user32.UnhookWindowsHookEx(self.hook_id)
            self.hook_id = None
        CrosshairOverlay._instance = None

    # ── 消息循环 ────────────────────────────────────────────────
    def pump_messages(self):
        """非阻塞消息处理（用于与 tkinter 共存）"""
        msg = MSG()
        while user32.PeekMessageW(byref(msg), None, 0, 0, 1):  # PM_REMOVE
            if msg.message == WM_DESTROY:
                self.running = False
                user32.PostQuitMessage(0)
                return False
            user32.TranslateMessage(byref(msg))
            user32.DispatchMessageW(byref(msg))
        return self.running

    def shutdown(self):
        self.uninstall_hook()
        self.destroy_render()
        if self.hwnd:
            user32.DestroyWindow(self.hwnd)
            self.hwnd = None


# ══════════════════════════════════════════════════════════════════
#  控制面板 (tkinter)
# ══════════════════════════════════════════════════════════════════

class ControlPanel:
    """tkinter 控制面板。在独立线程中运行。"""

    def __init__(self, overlay):
        self.overlay = overlay
        self.root    = None
        self._vars   = {}
        self._widget_map = {}

    def start(self):
        """在主线程中启动 tkinter 主循环。"""
        import tkinter as tk
        from tkinter import ttk

        self.root = tk.Tk()
        self.root.title("CrosshairX — 控制面板")
        self.root.resizable(False, False)
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)

        # 置顶
        self.root.attributes('-topmost', True)

        pad = {'padx': 8, 'pady': 4}
        row = 0

        # ── 准星显示开关 ──
        self._vars['visible'] = tk.BooleanVar(value=True)
        cb = ttk.Checkbutton(self.root, text="显示准星", variable=self._vars['visible'],
                             command=self._on_visible)
        cb.grid(row=row, column=0, columnspan=3, sticky='w', **pad)
        row += 1

        # ── 热键开关 ──
        self._vars['hotkeys'] = tk.BooleanVar(value=True)
        cb = ttk.Checkbutton(self.root, text="启用方向键调整", variable=self._vars['hotkeys'],
                             command=self._on_hotkeys)
        cb.grid(row=row, column=0, columnspan=3, sticky='w', **pad)
        row += 1

        ttk.Separator(self.root, orient='horizontal').grid(
            row=row, column=0, columnspan=3, sticky='ew', **pad)
        row += 1

        # ── 显示器选择 ──
        ttk.Label(self.root, text="显示器:").grid(row=row, column=0, sticky='w', **pad)
        n = self.overlay.num_monitors()
        self._vars['monitor'] = tk.StringVar(value=str(self.overlay.monitor_idx + 1))
        monitor_options = [str(i + 1) for i in range(n)]
        cb = ttk.Combobox(self.root, textvariable=self._vars['monitor'],
                          values=monitor_options, state='readonly', width=4)
        cb.grid(row=row, column=1, sticky='w', **pad)
        cb.bind('<<ComboboxSelected>>', self._on_monitor)
        row += 1

        # ── 半径 ──
        ttk.Label(self.root, text="准星半径:").grid(row=row, column=0, sticky='w', **pad)
        self._vars['radius'] = tk.IntVar(value=self.overlay.radius)
        ttk.Spinbox(self.root, from_=2, to=100, textvariable=self._vars['radius'],
                    width=5, command=self._on_radius).grid(row=row, column=1, sticky='w', **pad)
        ttk.Label(self.root, text="px").grid(row=row, column=2, sticky='w', **pad)
        row += 1

        # ── 线宽 (像素精确) ──
        ttk.Label(self.root, text="线宽:").grid(row=row, column=0, sticky='w', **pad)
        self._vars['thickness'] = tk.IntVar(value=self.overlay.thickness)
        ttk.Spinbox(self.root, from_=1, to=30, textvariable=self._vars['thickness'],
                    width=5, command=self._on_thickness).grid(row=row, column=1, sticky='w', **pad)
        ttk.Label(self.root, text="px  (物理像素)").grid(row=row, column=2, sticky='w', **pad)
        row += 1

        ttk.Separator(self.root, orient='horizontal').grid(
            row=row, column=0, columnspan=3, sticky='ew', **pad)
        row += 1

        # ── 颜色 ──
        ttk.Label(self.root, text="颜色:").grid(row=row, column=0, sticky='w', **pad)

        color_frame = ttk.Frame(self.root)
        color_frame.grid(row=row, column=1, columnspan=2, sticky='w', **pad)
        row += 1

        for i, (label, attr, max_val) in enumerate([
            ('R', 'r', 255), ('G', 'g', 255), ('B', 'b', 255), ('A', 'a', 255),
        ]):
            ttk.Label(color_frame, text=label).grid(row=i, column=0, sticky='e', **pad)
            self._vars[attr] = tk.IntVar(value=getattr(self.overlay, attr))
            ttk.Scale(color_frame, from_=0, to=max_val, orient='horizontal',
                      variable=self._vars[attr], length=150,
                      command=lambda v, a=attr: self._on_color(a, v)).grid(
                row=i, column=1, sticky='ew', **pad)
            self._vars[f'{attr}_lbl'] = tk.StringVar(value=str(getattr(self.overlay, attr)))
            ttk.Label(color_frame, textvariable=self._vars[f'{attr}_lbl'], width=3).grid(
                row=i, column=2, sticky='w', **pad)

        # 颜色预览
        self._color_preview = tk.Canvas(color_frame, width=60, height=24,
                                         bg=self._hex_color(), highlightthickness=1,
                                         highlightbackground='#666')
        self._color_preview.grid(row=4, column=0, columnspan=3, pady=4)

        row += 1
        ttk.Separator(self.root, orient='horizontal').grid(
            row=row, column=0, columnspan=3, sticky='ew', **pad)
