      ID2D1SolidColorBrush*br=NULL;
      D2D1_COLOR_F clr={g_cr,g_cg,g_cb,g_ca};
      ID2D1RenderTarget_CreateSolidColorBrush(rt,clr,NULL,&br);
      if(br){
        ID2D1RenderTarget_BeginDraw(rt);
        D2D1_RECT_F H={(FLOAT)(cx-g_r),(FLOAT)(cy-g_t/2),(FLOAT)(cx+g_r+1),(FLOAT)(cy-g_t/2+g_t)};
        D2D1_RECT_F V={(FLOAT)(cx-g_t/2),(FLOAT)(cy-g_r),(FLOAT)(cx-g_t/2+g_t),(FLOAT)(cy+g_r+1)};
        ID2D1RenderTarget_FillRectangle(rt,&H,(ID2D1Brush*)br);
        ID2D1RenderTarget_FillRectangle(rt,&V,(ID2D1Brush*)br);
