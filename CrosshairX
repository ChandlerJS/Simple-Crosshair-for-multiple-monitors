        ttk.Spinbox(self.root, from_=-2000, to=2000, textvariable=self._vars['offset_x'],
                    width=6, command=self._on_offset).grid(row=row, column=1, sticky='w', **pad)
        ttk.Label(self.root, text="px").grid(row=row, column=2, sticky='w', **pad)
        row += 1

        ttk.Label(self.root, text="Y 偏移:").grid(row=row, column=0, sticky='w', **pad)
        self._vars['offset_y'] = tk.IntVar(value=self.overlay.offset_y)
        ttk.Spinbox(self.root, from_=-2000, to=2000, textvariable=self._vars['offset_y'],
                    width=6, command=self._on_offset).grid(row=row, column=1, sticky='w', **pad)
        ttk.Label(self.root, text="px").grid(row=row, column=2, sticky='w', **pad)
        row += 1

        # ── 按钮 ──
        btn_frame = ttk.Frame(self.root)
        btn_frame.grid(row=row, column=0, columnspan=3, pady=10)
        ttk.Button(btn_frame, text="复位偏移", command=self._on_reset).pack(side='left', padx=4)
        ttk.Button(btn_frame, text="退出", command=self._on_close).pack(side='left', padx=4)

        row += 1

        # ── 状态栏 ──
        self._vars['status'] = tk.StringVar(value="准星运行中")
        ttk.Label(self.root, textvariable=self._vars['status'],
                  foreground='#666').grid(row=row, column=0, columnspan=3, **pad)

        self.root.geometry("+%d+%d" % (50, 100))

        # 定时器：与 overlay 消息泵同步
        self._poll_overlay()

        self.root.mainloop()

    def _poll_overlay(self):
        """定期处理 overlay 消息，保持窗口响应。"""
        if self.overlay.running:
            alive = self.overlay.pump_messages()
            if not alive:
                self.root.destroy()
                return
            self.root.after(20, self._poll_overlay)
        else:
            self.root.destroy()

    def _hex_color(self):
        return f'#{self.overlay.r:02x}{self.overlay.g:02x}{self.overlay.b:02x}'

    def _apply_all(self):
        """将所有设置同步到 overlay。"""
        o = self.overlay
        o.hotkeys_enabled = self._vars['hotkeys'].get()
        # 显示器
        idx = int(self._vars['monitor'].get()) - 1
        if idx != o.monitor_idx and 0 <= idx < len(o.monitors):
            o.monitor_idx = idx
            o.offset_x = 0
            o.offset_y = 0
            self._vars['offset_x'].set(0)
            self._vars['offset_y'].set(0)
        # 外观
        o.radius    = self._vars['radius'].get()
        o.thickness = self._vars['thickness'].get()
        o.r = self._vars['r'].get()
        o.g = self._vars['g'].get()
        o.b = self._vars['b'].get()
        o.a = self._vars['a'].get()
        # 偏移
        o.offset_x = self._vars['offset_x'].get()
        o.offset_y = self._vars['offset_y'].get()
        # 强制重绘
        o._last_pos = (-9999, -9999)
        # 可见性
        if self._vars['visible'].get() and o.hwnd:
            user32.ShowWindow(o.hwnd, SW_SHOWNOACTIVATE)
        elif not self._vars['visible'].get() and o.hwnd:
            user32.ShowWindow(o.hwnd, 0)  # SW_HIDE

    # ── 事件处理 ──
    def _on_visible(self):
        self._apply_all()
        s = "准星运行中" if self._vars['visible'].get() else "准星已隐藏"
        self._vars['status'].set(s)

    def _on_hotkeys(self):
        self.overlay.hotkeys_enabled = self._vars['hotkeys'].get()
        s = "热键已启用" if self._vars['hotkeys'].get() else "热键已禁用"
        self._vars['status'].set(s)

    def _on_monitor(self, _e=None):
        self._apply_all()
        r = self.overlay.monitor_rect()
        w, h = r.right - r.left, r.bottom - r.top
        self._vars['status'].set(f"→ 显示器 [{self.overlay.monitor_idx + 1}] {w}x{h}")

    def _on_radius(self):
        self._apply_all()

    def _on_thickness(self):
        self._apply_all()

    def _on_color(self, attr, val):
        v = int(float(val))
        self._vars[attr].set(v)
        self._vars[f'{attr}_lbl'].set(str(v))
        self._apply_all()
        self._color_preview.configure(bg=self._hex_color())

    def _on_offset(self):
        self._apply_all()

    def _on_reset(self):
        self._vars['offset_x'].set(0)
        self._vars['offset_y'].set(0)
        self._vars['radius'].set(6)
        self._vars['thickness'].set(2)
        self._vars['r'].set(0)
        self._vars['g'].set(255)
        self._vars['b'].set(0)
        self._vars['a'].set(230)
        for attr in ['r', 'g', 'b', 'a']:
            self._vars[f'{attr}_lbl'].set(str(self._vars[attr].get()))
        self.overlay.monitor_idx = 0
        self._vars['monitor'].set('1')
        self.overlay.offset_x = 0
        self.overlay.offset_y = 0
        self._apply_all()
        self._color_preview.configure(bg=self._hex_color())
        self._vars['status'].set("已复位")

    def _on_close(self):
        self.overlay.running = False
        if self.overlay.hwnd:
            user32.PostMessageW(self.overlay.hwnd, WM_DESTROY, 0, 0)
        self.root.destroy()


