def run_overlay_cli(args):
    """无 GUI 的纯命令行覆盖模式。"""
    try:
        sys.stdout.reconfigure(encoding='utf-8')
    except Exception:
        pass

    o = CrosshairOverlay()
    o.enum_monitors()
    if o.num_monitors() == 0:
        print("错误: 未检测到显示器。")
        return

    o.monitor_idx = max(0, min(args.monitor - 1, o.num_monitors() - 1))
    o.offset_x = args.offset_x
    o.offset_y = args.offset_y
    o.radius   = args.radius
    o.thickness = args.width

    cp = [int(x.strip()) for x in args.color.split(',')]
    if len(cp) >= 3: o.r, o.g, o.b = cp[0:3]
    if len(cp) >= 4: o.a = cp[3]

    print("=" * 60)
    print("  CrosshairX — 精确像素十字准星")
    print("=" * 60)
    print(f"  显示器: {o.num_monitors()} 个")
    for i, m in enumerate(o.monitors):
        r = m['rect']; w, h = r.right - r.left, r.bottom - r.top
        tag = " [主]" if m['primary'] else ""
        print(f"    [{i+1}]{tag} {w}x{h} @ ({r.left}, {r.top})")
    r = o.monitor_rect()
    print(f"\n  当前: [{o.monitor_idx+1}] {r.right-r.left}x{r.bottom-r.top}")
    print(f"  偏移: ({o.offset_x:+d}, {o.offset_y:+d})")
    print(f"  准星: 半径={o.radius}px, 线宽={o.thickness}px")
    print(f"  颜色: RGBA({o.r},{o.g},{o.b},{o.a})")
    print()
    print("  方向键=移动 | Shift=加速 | M/1-9=切换显示器 | R=复位")
    print("=" * 60)

    try:
        o.create_window()
        o.install_hook()
        print("  [OK] 准星已显示 (关闭控制面板退出)\n")

        # 独立消息循环
        msg = MSG()
        while o.running:
            ret = user32.GetMessageW(byref(msg), None, 0, 0)
            if ret <= 0:
                break
            user32.TranslateMessage(byref(msg))
            user32.DispatchMessageW(byref(msg))
    except Exception as e:
        print(f"\n错误: {e}")
        import traceback; traceback.print_exc()
    finally:
        o.shutdown()
    print("\n程序已退出。")


