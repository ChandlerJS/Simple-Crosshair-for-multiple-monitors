          D2D1_RECT_F V={(FLOAT)(cx-g_t/2),(FLOAT)(cy-g_r),(FLOAT)(cx-g_t/2+g_t),(FLOAT)(cy+g_r+1)};
          ID2D1RenderTarget_FillRectangle(rt,&H,(ID2D1Brush*)br);
          ID2D1RenderTarget_FillRectangle(rt,&V,(ID2D1Brush*)br);
          ID2D1RenderTarget_EndDraw(rt,NULL,NULL);br->lpVtbl->Release(br);
        }
        rt->lpVtbl->Release(rt);
