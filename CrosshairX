static HRESULT STDMETHODCALLTYPE hp(IDXGISwapChain*sc,UINT sy,UINT fl){
  EnterCriticalSection(&g_cs);E*e=NULL;
  for(int i=0;i<g_n;i++)if(g_s[i].sc==sc){e=&g_s[i];break;}
  if(!e){LeaveCriticalSection(&g_cs);return E_NOTIMPL;}
  PFn o=e->o;LeaveCriticalSection(&g_cs);dr(sc);return o(sc,sy,fl);
}
static HRESULT STDMETHODCALLTYPE hp1(IDXGISwapChain1*sc,UINT sy,UINT fl,const DXGI_PRESENT_PARAMETERS*p){
  EnterCriticalSection(&g_cs);E*e=NULL;
  for(int i=0;i<g_n;i++)if((IDXGISwapChain1*)g_s[i].sc==sc){e=&g_s[i];break;}
  if(!e||!e->o1){LeaveCriticalSection(&g_cs);return E_NOTIMPL;}
  P1Fn o=e->o1;LeaveCriticalSection(&g_cs);dr((IDXGISwapChain*)sc);return o(sc,sy,fl,p);
}

static void hs(IDXGISwapChain*sc){
  if(!sc||g_n>=MAX_SC)return;
  EnterCriticalSection(&g_cs);
  for(int i=0;i<g_n;i++)if(g_s[i].sc==sc){LeaveCriticalSection(&g_cs);return;}
  void**v=vt(sc);if(!v){LeaveCriticalSection(&g_cs);return;}
  E*e=&g_s[g_n];e->sc=sc;e->o=(PFn)vh(v,SC_P,(void*)hp);
  if(!e->o){LeaveCriticalSection(&g_cs);return;}
  __try{e->o1=(P1Fn)vh(v,SC_P1,(void*)hp1);}__except(1){}
  g_n++;LeaveCriticalSection(&g_cs);
}

static HRESULT STDMETHODCALLTYPE hc(IDXGIFactory*f,IUnknown*d,DXGI_SWAP_CHAIN_DESC*desc,IDXGISwapChain**pp){
  HRESULT hr=g_osc(f,d,desc,pp);if(SUCCEEDED(hr)&&pp&&*pp)hs(*pp);return hr;
}
static HRESULT STDMETHODCALLTYPE hch(IDXGIFactory2*f,IUnknown*d,HWND h,const DXGI_SWAP_CHAIN_DESC1*desc,const DXGI_SWAP_CHAIN_FULLSCREEN_DESC*fs,IDXGIOutput*ro,IDXGISwapChain1**pp){
  HRESULT hr=g_osch(f,d,h,desc,fs,ro,pp);if(SUCCEEDED(hr)&&pp&&*pp)hs((IDXGISwapChain*)*pp);return hr;
}

static BOOL inst(void){
  if(g_fh)return 1;
  ID3D11Device*dev=NULL;ID3D11DeviceContext*ctx=NULL;D3D_FEATURE_LEVEL fl;
  HRESULT hr=D3D11CreateDevice(NULL,D3D_DRIVER_TYPE_HARDWARE,NULL,0,NULL,0,D3D11_SDK_VERSION,&dev,&fl,&ctx);
  if(FAILED(hr))hr=D3D11CreateDevice(NULL,D3D_DRIVER_TYPE_WARP,NULL,0,NULL,0,D3D11_SDK_VERSION,&dev,&fl,&ctx);
  if(FAILED(hr)||!dev)return 0;
