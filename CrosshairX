def build_dll(msvc=False):
    script_dir = os.path.dirname(os.path.abspath(__file__))
    out_dir = os.path.join(script_dir, "crosshair_hook")
    os.makedirs(out_dir, exist_ok=True)
    c_path = os.path.join(out_dir, "crosshair_hook.c")
    with open(c_path, 'w') as f:
        f.write(C_DLL_SOURCE)
    print(f"  [OK] C 源码已写入: {c_path}")

    import subprocess
    dll_path = os.path.join(out_dir, "crosshair_hook.dll")

    if msvc:
        cmd = f'cl /nologo /LD /O2 /MD /GS- "{c_path}" /Fe:"{dll_path}" /link d3d11.lib dxgi.lib d2d1.lib dwrite.lib user32.lib gdi32.lib'
        result = subprocess.run(cmd, shell=True)
    else:
        result = None
        for cc in ["x86_64-w64-mingw32-gcc", "gcc"]:
            cmd = f'{cc} -shared -O2 -s -o "{dll_path}" "{c_path}" -ld3d11 -ldxgi -ld2d1 -ldwrite -lgdi32 -luser32 -m64 -static-libgcc -Wl,--subsystem,windows'
            result = subprocess.run(cmd, shell=True)
            if result.returncode == 0:
                break

    if result and result.returncode == 0 and os.path.exists(dll_path):
        print(f"  [OK] DLL 编译成功 ({os.path.getsize(dll_path):,} bytes)")
        return dll_path
    else:
        print("  [ERROR] 编译失败。请安装 MinGW-w64: https://www.mingw-w64.org/")
        return None


def inject(process_name, **kw):
    import ctypes.wintypes as w
    dll_path = kw.get('dll')
    if not dll_path:
        d = os.path.dirname(os.path.abspath(__file__))
        dll_path = os.path.join(d, "crosshair_hook", "crosshair_hook.dll")
    dll_path = os.path.abspath(dll_path)
    if not os.path.exists(dll_path) and not kw.get('list_only'):
        print(f"  [ERROR] DLL 未找到: {dll_path}")
        print("  请先编译: python CrosshairX build-dll")
        return

    class PE32(Structure):
        _fields_ = [('dwSize', w.DWORD),('cntUsage', w.DWORD),('th32ProcessID', w.DWORD),
                    ('th32DefaultHeapID', POINTER(w.ULONG)),('th32ModuleID', w.DWORD),
                    ('cntThreads', w.DWORD),('th32ParentProcessID', w.DWORD),
                    ('pcPriClassBase', w.LONG),('dwFlags', w.DWORD),('szExeFile',ctypes.c_char*260)]

    def by_name(n):
        pids=[];snap=kernel32.CreateToolhelp32Snapshot(0x2,0)
        if snap==-1:return pids
        e=PE32();e.dwSize=sizeof(PE32)
        if kernel32.Process32First(snap,byref(e)):
            nl=n.lower()
            while 1:
                if nl in e.szExeFile.decode('utf-8','ignore').lower():pids.append(e.th32ProcessID)
                if not kernel32.Process32Next(snap,byref(e)):break
        kernel32.CloseHandle(snap);return pids

    def by_win(t):
        r=[]
        @WINFUNCTYPE(w.BOOL,w.HWND,w.LPARAM)
        def cb(hw,lp):
            if user32.IsWindowVisible(hw):
                n=user32.GetWindowTextLengthW(hw)
                if n>0:
                    b=ctypes.create_unicode_buffer(n+1);user32.GetWindowTextW(hw,b,n+1)
                    if t.lower() in b.value.lower():
                        pid=w.DWORD();user32.GetWindowThreadProcessId(hw,byref(pid));r.append(pid.value)
            return 1
        user32.EnumWindows(cb,0);return list(set(r))

    pids=by_name(process_name)
    if not pids:pids=by_win(process_name)
    if not pids:print(f"\n  [ERROR] 未找到: {process_name}");return

    print(f"\n找到 {len(pids)} 个进程:")
    for pid in pids:
        h=kernel32.OpenProcess(0x400|0x10,0,pid)
        n="???"
        if h:b=ctypes.create_string_buffer(260);ctypes.windll.psapi.GetModuleBaseNameA(h,None,b,260);kernel32.CloseHandle(h);n=b.value.decode('utf-8','ignore')
        print(f"  PID: {pid:6d}  |  {n}")

    if kw.get('list_only'):return

    target= pids[0] if len(pids)==1 else None
    if not target:
        try:target=pids[int(input(f"\n选择 (1-{len(pids)}): ").strip())-1]
        except:print("[ERROR] 取消");return

    if not kw.get('no_confirm'):
        print(f"\n{'='*60}\n!!! 反作弊警告 !!!\n{'='*60}")
        print("DLL 注入会被反作弊系统 (EAC, BattlEye, Vanguard) 封禁。")
        print("仅用于单机游戏!")
        if input("\n确认? (yes): ").strip().lower()!='yes':print("已取消.");return

    import tempfile
    cfg=os.path.join(os.environ.get('TEMP',tempfile.gettempdir()),'crosshair_hook.ini')
    with open(cfg,'w') as f:
        f.write(f'[crosshair]\noffset_x={kw.get("offset_x",0)}\noffset_y={kw.get("offset_y",0)}\n')
        f.write(f'radius={kw.get("radius",6)}\nwidth={kw.get("width",2)}\ncolor={kw.get("color","0,255,0,230")}\n')

    hProc=kernel32.OpenProcess(0x2|0x400|0x8|0x20|0x10,0,target)
    if not hProc:print("[ERROR] 无法打开进程 (需要管理员权限)");return

    try:
        dll_b=dll_path.encode('utf-16-le')+b'\x00\x00'
        pR=kernel32.VirtualAllocEx(hProc,None,len(dll_b),0x1000|0x2000,0x04)
        wr=w.SIZE_T();kernel32.WriteProcessMemory(hProc,pR,dll_b,len(dll_b)-2,byref(wr))
        pLL=kernel32.GetProcAddress(kernel32.GetModuleHandleW("kernel32.dll"),"LoadLibraryW")
        hT=kernel32.CreateRemoteThread(hProc,None,0,pLL,pR,0,None)
        kernel32.WaitForSingleObject(hT,5000)
        cd=w.DWORD();kernel32.GetExitCodeThread(hT,byref(cd));kernel32.CloseHandle(hT)
        print(f"  [OK] DLL 注入成功! 基址: 0x{cd.value:016X}" if cd.value else "  [WARN] 注入可能失败")
    except Exception as e:print(f"  [ERROR] {e}")
    finally:kernel32.CloseHandle(hProc)


